# Copy only the settings needed for a reproducible local experiment.
JUNAS_CONFIG=config.toml
JUNAS_SEED=42
JUNAS_DETERMINISTIC=1
# Optional local NER: install junas[ner] and en_core_web_sm before enabling.
JUNAS_LOCAL_NER_FALLBACK=0
JUNAS_LOCAL_NER_MODEL=en_core_web_sm
# Optional OCR: install junas[ocr] and native Tesseract before selecting tesseract.
JUNAS_IMAGE_SCAN_PROVIDER=none
JUNAS_DOCUMENT_FAIL_CLOSED=1
# No external provider calls in the default strict baseline.
JUNAS_PUBLIC_EVIDENCE_ENABLED=0
JUNAS_LLM_ENABLED=0
JUNAS_CACHE_DIR=.junas-cache
